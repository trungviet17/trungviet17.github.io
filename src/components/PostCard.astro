---
import type { Post } from '@/lib/posts';
import { href, excerpt, minutesToRead, updatedDate } from '@/lib/posts';
import PostMeta from './PostMeta.astro';

interface Props { post: Post }
const { post } = Astro.props;
const { title, categories, tags, date, pinned } = post.data;
---

<article class="group border-b border-[var(--border)] py-6 first:pt-0">
  <div class="flex flex-wrap items-center gap-2 text-xs">
    {pinned && <span class="rounded-full bg-[var(--accent)] px-2 py-0.5 font-medium text-white">Ghim</span>}
    {
      categories.map((c) => (
        <a href={href.category(c)} class="text-[var(--accent)] hover:underline">{c}</a>
      ))
    }
  </div>

  <h2 class="mt-1.5 text-xl font-bold tracking-tight">
    <a href={href.post(post)} class="transition group-hover:text-[var(--accent)]">{title}</a>
  </h2>

  <p class="mt-2 line-clamp-3 text-[var(--text-muted)]">{excerpt(post)}</p>

  <PostMeta
    class="mt-3"
    date={date}
    updated={updatedDate(post)}
    minutes={minutesToRead(post)}
  />

  {
    tags.length > 0 && (
      <ul class="mt-2.5 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <li>
            <a
              href={href.tag(t)}
              class="inline-block rounded-md bg-[var(--bg-subtle)] px-2 py-0.5 text-xs text-[var(--text-muted)] transition hover:text-[var(--accent)]"
            >#{t}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

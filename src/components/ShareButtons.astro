---
import { UI } from '@/config';

interface Props { title: string; url: URL }
const { title, url } = Astro.props;

const encoded = { t: encodeURIComponent(title), u: encodeURIComponent(url.href) };
const targets = [
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${encoded.t}&url=${encoded.u}`,
    path: 'M18.9 2H22l-6.8 7.7L23 22h-6.3l-4.9-6.4L6.2 22H3l7.3-8.3L2.4 2h6.4l4.4 5.9zm-1.1 18h1.7L8.3 3.8H6.5z' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encoded.u}`,
    path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encoded.u}`,
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z' },
];
---

<div class="flex items-center gap-3" data-pagefind-ignore>
  <span class="text-sm text-[var(--text-muted)]">{UI.share}</span>
  <div class="flex items-center gap-2">
    {
      targets.map((t) => (
        <a
          href={t.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.name}
          class="grid size-8 place-items-center rounded-md border border-[var(--border)] text-[var(--text-muted)] transition hover:text-[var(--accent)]"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={t.path} /></svg>
        </a>
      ))
    }
    <button
      id="copy-link"
      type="button"
      data-url={url.href}
      aria-label="Sao chép liên kết"
      class="grid size-8 place-items-center rounded-md border border-[var(--border)] text-[var(--text-muted)] transition hover:text-[var(--accent)]"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"></path>
        <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const button = document.getElementById('copy-link');
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.url ?? location.href);
      const previous = button.getAttribute('aria-label');
      button.setAttribute('aria-label', 'Đã sao chép');
      setTimeout(() => button.setAttribute('aria-label', previous ?? ''), 1500);
    } catch {
      /* clipboard bị chặn — bỏ qua */
    }
  });
</script>

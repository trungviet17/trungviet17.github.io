---
import ThemeToggle from './ThemeToggle.astro';
import { SITE, SOCIAL, NAV, UI } from '@/config';

const path = Astro.url.pathname;
const isActive = (target: string) =>
  target === '/' ? path === '/' || /^\/page\d+\/$/.test(path) : path.startsWith(target);

const ICONS: Record<string, string> = {
  github:
    'M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.2-4.6-5.1 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.8-4.6 5 .4.3.7 1 .7 2v3c0 .3.2.6.7.5A10.2 10.2 0 0 0 22 12.3C22 6.6 17.5 2 12 2z',
  facebook:
    'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z',
};
---

<aside class="flex flex-col gap-6" data-pagefind-ignore>
  <a href="/" class="flex flex-col items-center gap-3 text-center lg:items-start lg:text-left">
    <img
      src={SITE.avatar}
      alt={SITE.author}
      width="96"
      height="96"
      class="size-20 rounded-full ring-2 ring-[var(--border)]"
    />
    <span>
      <span class="block text-lg font-bold">{SITE.title}</span>
      <span class="block text-sm text-[var(--text-muted)]">{SITE.tagline}</span>
    </span>
  </a>

  <nav aria-label="Điều hướng chính">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 lg:flex-col lg:gap-1">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md py-1 text-sm transition lg:px-2',
                isActive(item.href)
                  ? 'font-semibold text-[var(--accent)]'
                  : 'text-[var(--text-muted)] hover:text-[var(--text)]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex items-center gap-3">
    {
      SOCIAL.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
          class="text-[var(--text-muted)] transition hover:text-[var(--accent)]"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={ICONS[item.icon]} />
          </svg>
        </a>
      ))
    }
    <a
      href="/feed.xml"
      aria-label="RSS"
      class="text-[var(--text-muted)] transition hover:text-[var(--accent)]"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.2 17.8a2.2 2.2 0 1 1-4.4 0 2.2 2.2 0 0 1 4.4 0zM2 10.5v3a8.5 8.5 0 0 1 8.5 8.5h3A11.5 11.5 0 0 0 2 10.5zM2 4v3c8.3 0 15 6.7 15 15h3C20 12.1 11.9 4 2 4z" />
      </svg>
    </a>
    <a
      href="/search/"
      aria-label={UI.search}
      class="text-[var(--text-muted)] transition hover:text-[var(--accent)]"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
    </a>

    <div class="ml-auto lg:ml-0">
      <ThemeToggle />
    </div>
  </div>
</aside>

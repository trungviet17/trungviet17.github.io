---
import { getEntry, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Thiếu src/content/pages/about.md');
const { Content } = await render(page);
---

<PageLayout title={page.data.title} description={page.data.description}>
  <div class="prose dark:prose-invert max-w-none prose-a:text-[var(--accent)]">
    <Content />
  </div>
</PageLayout>

<script>
  import { initLightbox } from '@/scripts/lightbox';
  initLightbox();
</script>

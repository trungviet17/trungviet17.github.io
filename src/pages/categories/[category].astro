---
import type { GetStaticPaths } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts, groupByCategory } from '@/lib/posts';
import { UI } from '@/config';

export const getStaticPaths: GetStaticPaths = async () => {
  const groups = groupByCategory(await getPublishedPosts());
  return [...groups.entries()].map(([slug, group]) => ({
    params: { category: slug },
    props: { name: group.name, posts: group.posts },
  }));
};

const { name, posts } = Astro.props;
---

<PageLayout title={name} description={`Các bài viết trong chuyên mục ${name}`} lead={UI.postCount(posts.length)}>
  {posts.map((post) => <PostCard post={post} />)}
</PageLayout>

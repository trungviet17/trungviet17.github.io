---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
const posts = await getCollection('posts');
const rendered = await Promise.all(posts.map(async (p) => ({ post: p, ...(await render(p)) })));
---

<BaseLayout title="debug" noindex>
  {
    rendered.map(({ post, Content }) => (
      <article class="prose dark:prose-invert mb-16 max-w-none">
        <h1>{post.data.title} <code>({post.id})</code></h1>
        <Content />
      </article>
    ))
  }
</BaseLayout>
